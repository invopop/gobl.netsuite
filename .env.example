# NetSuite Token-Based Authentication credentials used by `gobl.netsuite probe`.
# See "NetSuite Setup" in the README for where to find each value.
# Account ID as shown in Setup > Company > Company Information, e.g. 1234567 or 1234567_SB1.
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
